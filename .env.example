# Auth (public endpoints — no bearer required)
JWT_SECRET=dev-insecure-change-me
REDIS_ADDR=localhost:6379
DEPLOYMENT_ENVIRONMENT=dev
ORBIT_INTERNAL_TOKEN=dev-internal-token
# Deprecated: trusts X-Forwarded-For from EVERY peer (spoofable while the port is reachable). Use RATE_LIMIT_TRUSTED_PROXIES.
RATE_LIMIT_TRUST_PROXY=false
# CIDRs whose X-Forwarded-For is trusted, e.g. 172.16.0.0/12 for Docker bridges; the rightmost untrusted address is the client
RATE_LIMIT_TRUSTED_PROXIES=

# Upstream gRPC (see README)
# AUTH_GRPC_ADDR=localhost:10010
