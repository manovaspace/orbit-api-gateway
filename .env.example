# Auth (public endpoints — no bearer required)
JWT_SECRET=dev-insecure-change-me
REDIS_ADDR=localhost:6379
DEPLOYMENT_ENVIRONMENT=dev
ORBIT_INTERNAL_TOKEN=dev-internal-token
# Deprecated: trusts X-Forwarded-For from EVERY peer (spoofable while the port is reachable). Use RATE_LIMIT_TRUSTED_PROXIES.
RATE_LIMIT_TRUST_PROXY=false
# CIDRs whose X-Forwarded-For is trusted, e.g. 172.16.0.0/12 for Docker bridges; the rightmost untrusted address is the client
RATE_LIMIT_TRUSTED_PROXIES=

# Upstream gRPC (see README)
# AUTH_GRPC_ADDR=localhost:10010

# Staff sign-in with the Keycloak staff realm (ADR-061). Staff OIDC is on only when
# ISSUER, AUDIENCE and at least one ALLOWED_GROUPS entry are set (comma list; "dev" and "/dev" match alike).
# STAFF_OIDC_ISSUER=https://identity.internal.manova.space/realms/staff
# STAFF_OIDC_AUDIENCE=
# STAFF_OIDC_ALLOWED_GROUPS=
# Optional; defaults to <issuer>/protocol/openid-connect/certs
# STAFF_OIDC_JWKS_URL=
# Legacy HS256 staff tokens (signed with JWT_SECRET or STAFF_SECRET). Default true; set false once the console signs in with Keycloak.
# STAFF_HS256_ENABLED=true
